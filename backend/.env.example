# Variaveis de ambiente — copie este arquivo para .env e preencha os valores

# Segredo JWT (gere um valor aleatorio seguro: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_ALEATORIA

# Algoritmo JWT
ALGORITHM=HS256

# Tempo de expiracao do token (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# URL do banco de dados
# SQLite (desenvolvimento local):
DATABASE_URL=sqlite:///./futsal_scout.db
# PostgreSQL (producao):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/futsal_scout

# Dados do administrador inicial (criado automaticamente no primeiro run)
ADMIN_EMAIL=julio@futsalscout.com
ADMIN_PASSWORD=Admin@123
ADMIN_NOME=Julio Martins

# Ambiente (development / production)
ENVIRONMENT=development
